meta {
  name: Update Ad
  type: http
  seq: 6
}

put {
  url: {{base_url}}/ads/{{ad_id}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "title": "Updated Ad Title",
    "budget": 600
  }
}

settings {
  encodeUrl: true
  timeout: 0
}