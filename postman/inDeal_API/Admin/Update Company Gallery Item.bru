meta {
  name: Update Company Gallery Item
  type: http
  seq: 13
}

put {
  url: {{base_url}}/admin/companies/{{company_id}}/gallery/1
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "imageFileId": {{file_id}},
    "description": "Updated by admin"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}