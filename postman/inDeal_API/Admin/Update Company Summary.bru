meta {
  name: Update Company Summary
  type: http
  seq: 201
}

put {
  url: {{base_url}}/admin/companies/{{company_id}}/summary
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  "summary": "Business description and achievements summary"
}

settings {
  encodeUrl: true
  timeout: 0
}
