meta {
  name: Add Company Gallery Item
  type: http
  seq: 12
}

post {
  url: {{base_url}}/admin/companies/{{company_id}}/gallery
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "imageFileId": {{file_id}},
    "description": "Admin added gallery item"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}