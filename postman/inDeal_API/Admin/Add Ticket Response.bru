meta {
  name: Add Ticket Response
  type: http
  seq: 211
}

post {
  url: {{base_url}}/admin/tickets/{{ticket_id}}/responses
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "message": "Thank you for reporting this issue. We are investigating."
  }
}

settings {
  encodeUrl: true
  timeout: 0
}