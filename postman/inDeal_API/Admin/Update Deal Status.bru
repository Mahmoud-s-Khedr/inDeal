meta {
  name: Update Deal Status
  type: http
  seq: 204
}

patch {
  url: {{base_url}}/admin/deals/{{deal_id}}/status
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "status": "published"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}