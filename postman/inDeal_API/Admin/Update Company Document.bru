meta {
  name: Update Company Document
  type: http
  seq: 17
}

put {
  url: {{base_url}}/admin/companies/{{company_id}}/documents/1
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "fileId": {{file_id}},
    "docType": "license",
    "title": "Updated License",
    "issuer": "Updated Issuer",
    "description": "Updated by admin"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}