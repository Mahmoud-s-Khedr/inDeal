meta {
  name: Add Company Contribution
  type: http
  seq: 20
}

post {
  url: {{base_url}}/admin/companies/{{company_id}}/contributions
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "type": "project",
    "title": "Admin added contribution",
    "description": "Description",
    "mediaFileId": {{file_id}},
    "mediaType": "image",
    "details": {
      "budget": 50000,
      "duration": "6 months"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}