meta {
  name: Update My Profile
  type: http
  seq: 2
}

put {
  url: {{base_url}}/users/me
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "firstName": "Updated",
    "lastName": "Name",
    "preferences": {
      "language": "en",
      "theme": "dark"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}