meta {
  name: Update My Profile Image
  type: http
  seq: 4
}

put {
  url: {{base_url}}/users/me/profile-image
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "profileImageFileId": {{file_id}}
  }
}

settings {
  encodeUrl: true
  timeout: 0
}