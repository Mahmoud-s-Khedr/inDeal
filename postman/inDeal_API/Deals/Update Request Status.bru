meta {
  name: Update Request Status
  type: http
  seq: 10
}

patch {
  url: {{base_url}}/deals/{{deal_id}}/requests/{{request_id}}/status
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "status": "accepted"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}