meta {
  name: Create Request
  type: http
  seq: 8
}

post {
  url: {{base_url}}/deals/{{deal_id}}/requests
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "message": "Interested in participating",
    "proposedPrice": 95000
  }
}

settings {
  encodeUrl: true
  timeout: 0
}