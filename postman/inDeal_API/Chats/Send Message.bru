meta {
  name: Send Message
  type: http
  seq: 6
}

post {
  url: {{base_url}}/chats/{{room_id}}/messages
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "content": "Hello, interested in your deal",
    "type": "text"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}