meta {
  name: Update Gallery Item
  type: http
  seq: 8
}

put {
  url: {{base_url}}/companies/me/gallery/1
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "imageFileId": {{file_id}},
    "description": "Updated description"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}