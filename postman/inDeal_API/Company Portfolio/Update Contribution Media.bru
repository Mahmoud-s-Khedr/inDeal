meta {
  name: Update Contribution Media
  type: http
  seq: 2003
}

put {
  url: {{base_url}}/companies/me/contributions/{{contribution_id}}/media/{{media_id}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "caption": "Updated caption",
    "sortOrder": 1
  }
}

docs {
  Update a media item. At least one field required.
  
  Body (all optional):
  - fileId: New file ID
  - mediaType: "image" | "video" | "file" | "url"
  - mediaUrl: External URL
  - caption: Description
  - sortOrder: Display order
}
