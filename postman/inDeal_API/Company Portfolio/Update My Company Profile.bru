meta {
  name: Update My Company Profile
  type: http
  seq: 2
}

put {
  url: {{base_url}}/companies/me
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Tech Innovations Inc.",
    "description": "A leading technology company specializing in innovative software solutions.",
    "address": "123 Innovation Drive, Silicon Valley, CA 94043",
    "phone": "+1-555-123-4567",
    "email": "contact@techinnovations.com",
    "website": "https://www.techinnovations.com",
    "companyType": "manufacturer",
    "companyIndustry": "technology",
    "manufacturingStrategy": "makeToOrder",
    "contacts": [
      {
        "type": "phone",
        "value": "+1-555-987-6543"
      },
      {
        "type": "email",
        "value": "support@techinnovations.com"
      }
    ],
    "locations": [
      "Silicon Valley",
      "New York",
      "London"
    ],
    "socialMediaLinks": [
      {
        "platform": "LinkedIn",
        "url": "https://www.linkedin.com/company/tech-innovations"
      },
      {
        "platform": "Twitter",
        "url": "https://twitter.com/techinnovations"
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
