meta {
  name: Add Contribution Media
  type: http
  seq: 2002
}

post {
  url: {{base_url}}/companies/me/contributions/{{contribution_id}}/media
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "fileId": 10,
    "mediaType": "image",
    "caption": "Product front view",
    "sortOrder": 0
  }
}

docs {
  Add a new media item to a contribution.
  
  Body:
  - fileId: (required for image/video/file) File ID from upload
  - mediaType: "image" | "video" | "file" | "url"
  - mediaUrl: (required for url type) External URL
  - caption: Optional description
  - sortOrder: Optional order (default 0)
}
