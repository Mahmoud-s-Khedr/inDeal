meta {
  name: Add Gallery Item
  type: http
  seq: 3
}

post {
  url: {{base_url}}/companies/me/gallery
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "imageFileId": {{file_id}},
    "description": "Factory floor"
  }
}

settings {
  encodeUrl: true
}
