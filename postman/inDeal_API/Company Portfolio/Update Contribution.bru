meta {
  name: Update Contribution
  type: http
  seq: 12
}

put {
  url: {{base_url}}/companies/me/contributions/1
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{auth_token}}
  Content-Type: application/json
}

body:json {
  {
    "type": "product",
    "title": "Updated title",
    "description": "Updated description",
    "mediaFileId": {{file_id}},
    "mediaType": "video",
    "details": {
      "updatedCategory": "software"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}