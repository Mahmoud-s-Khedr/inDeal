generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  AGENT   @map("agent")
  ADMIN   @map("admin")
  SUPPORT @map("support")

  @@map("user_role_enum")
}

enum UserStatus {
  PENDING   @map("pending")
  VERIFIED  @map("verified")
  SUSPENDED @map("suspended")

  @@map("user_status_enum")
}

model User {
  id            Int        @id @default(autoincrement())
  username      String     @unique @db.VarChar(50)
  email         String     @unique @db.VarChar(100)
  password_hash String     @db.VarChar(255)
  first_name    String     @db.VarChar(50)
  last_name     String     @db.VarChar(50)
  job_title     String?    @db.VarChar(100)
  role          UserRole?  @default(AGENT)
  status        UserStatus @default(PENDING)
  profile_image Int?
  preferences   Json?      @db.JsonB
  created_at    DateTime?  @default(now()) @db.Timestamp(6)
  updated_at    DateTime?  @default(now()) @db.Timestamp(6)

  password_history UserPasswordHistory[]

  @@map("users")
}

model UserPasswordHistory {
  id            Int       @id @default(autoincrement())
  user_id       Int
  password_hash String    @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_password_history")
}

model File {
  id          Int       @id @default(autoincrement())
  file_name   String    @db.VarChar(100)
  file_metadata Json?   @db.JsonB
  file_path   String    @db.VarChar(255)
  uploaded_at DateTime? @default(now()) @db.Timestamp(6)
  deleted_at  DateTime? @db.Timestamp(6)

  @@map("files")
}

model EmailLog {
  id         Int       @id @default(autoincrement())
  message_id String?   @db.VarChar(100)
  recipient  String    @db.VarChar(255)
  template   String?   @db.VarChar(50)
  subject    String?   @db.VarChar(255)
  status     String?   @default("queued") @db.VarChar(20)
  error      String?
  attempts   Int?      @default(0)
  sent_at    DateTime? @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([recipient])
  @@index([status])
  @@index([template])
  @@index([created_at(sort: Desc)])
  @@map("email_logs")
}
