# Runtime
NODE_ENV=production
PORT=3000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
LOG_SLOW_QUERY_MS=1000
LOG_FILE_ENABLED=false

# Database (host VM PostgreSQL)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=indeal
DB_PASSWORD=change_me
DB_NAME=indeal
DB_SSL=false
# Optional alternative to DB_* vars:
# DATABASE_URL=postgresql://indeal:change_me@host.docker.internal:5432/indeal

# Valkey
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=5m
JWT_ROTATE_BEFORE_EXP_SECONDS=60
AUTH_DEBUG_OTP_ENABLED=false

# Stateful session
SESSION_REFRESH_TTL_DAYS=7
SESSION_ROTATE_LEEWAY_SECONDS=300

# Feature limits
MAX_OPEN_DEALS_PER_COMPANY=25

# Storage (Cloudflare R2)
R2_BUCKET_NAME=indeal-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_PUBLIC_URL=https://<public-bucket-host>.r2.dev
R2_SIGNED_URL_TTL_SECONDS=300
R2_MAX_FILE_SIZE_BYTES=20971520

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.com
RESEND_FROM_NAME=inDeal Support

# Frontend / links
FRONTEND_BASE_URL=https://app.example.com
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
EMAIL_VERIFICATION_API_BASE_URL=https://api.example.com
EMAIL_VERIFICATION_PATH=/api/v1/auth/verify-email

# Password reset and docs
FORGOT_PASSWORD_ENABLED=true
SWAGGER_ENABLED=false

# Realtime
ENABLE_SOCKETIO=true
ENABLE_REDIS_ADAPTER=true

# Chat encryption
CHAT_MASTER_KEY=replace_with_64_hex_chars
