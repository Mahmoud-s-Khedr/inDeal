# Server
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info                    # error, warn, info, debug
LOG_FORMAT=pretty                 # pretty (dev) or json (prod)
LOG_REQUEST_BODY=true             # Log request bodies
LOG_RESPONSE_BODY=true            # Log response bodies
LOG_SLOW_QUERY_MS=1000            # Slow query threshold (ms)
LOG_FILE_ENABLED=false            # Enable file logging with rotation
LOG_FILE_PATH=./logs              # Log files directory
LOG_FILE_MAX_SIZE=10M             # Max size before rotation (K, M, G)
LOG_FILE_MAX_FILES=7              # Number of rotated files to keep

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=indeal

# Redis (Valkey)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
JWT_SECRET=change_this_secret_key_in_production
JWT_EXPIRES_IN=5m

# Stateful session (single JWT + Valkey)
# Access window inside the token (aexp) is short; the token's exp is the refresh window.
SESSION_ACCESS_TTL_MIN=5
SESSION_REFRESH_TTL_DAYS=7
SESSION_ROTATE_LEEWAY_SECONDS=300
SESSION_ENFORCE_LATEST_JTI=true

# Storage (Cloudflare R2)
R2_BUCKET_NAME=indeal-test
R2_ACCESS_KEY_ID=<your-r2-access-key>
R2_SECRET_ACCESS_KEY=<your-r2-secret-key>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_PUBLIC_URL=https://<public-bucket-host>.r2.dev
R2_SIGNED_URL_TTL_SECONDS=300
R2_MAX_FILE_SIZE_BYTES=20971520

# Firebase (Push Notifications via FCM)
# Required for mobile and web push notifications
# Download service account JSON from Firebase Console:
#   Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Note: The private key must be wrapped in quotes and have escaped newlines (\n)

# Resend / Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@indeal.local
RESEND_FROM_NAME=inDeal Support
FRONTEND_BASE_URL=https://app.indeal.local

# Company review notifications (optional)
# If set, admins will receive emails when a company is submitted/resubmitted for review.
COMPANY_REVIEW_NOTIFICATION_EMAIL=

EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
EMAIL_VERIFICATION_API_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_PATH=/api/v1/auth/verify-email

# Real-time (Socket.IO)
ENABLE_SOCKETIO=true
ENABLE_REDIS_ADAPTER=true      # Enable for horizontal scaling with multiple server instances

# Notification retention (days)
NOTIFICATION_RETENTION_READ_DAYS=90
NOTIFICATION_RETENTION_UNREAD_DAYS=180
