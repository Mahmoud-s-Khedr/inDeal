# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=indeal

# Redis (Valkey)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
JWT_SECRET=change_this_secret_key_in_production
JWT_EXPIRES_IN=7d

# Storage (Cloudflare R2)
R2_BUCKET_NAME=indeal-test
R2_ACCESS_KEY_ID=<your-r2-access-key>
R2_SECRET_ACCESS_KEY=<your-r2-secret-key>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_PUBLIC_URL=https://<public-bucket-host>.r2.dev
R2_SIGNED_URL_TTL_SECONDS=300
R2_MAX_FILE_SIZE_BYTES=20971520

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Resend / Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@indeal.local
RESEND_FROM_NAME=inDeal Support
FRONTEND_BASE_URL=https://app.indeal.local
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
EMAIL_VERIFICATION_API_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_PATH=/api/v1/auth/verify-email
